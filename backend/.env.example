# LLM(智谱 GLM-5.2 经 Anthropic 兼容 API)。从 https://open.bigmodel.cn 获取 key。
ANTHROPIC_API_KEY=你的智谱key
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=GLM-5.2
# 换 Claude:删 ANTHROPIC_BASE_URL,改 ANTHROPIC_API_KEY=sk-ant-...,ANTHROPIC_MODEL=claude-sonnet-5

#Vercel 真部署(https://vercel.com → Settings → Tokens,需 build 权限)
# ⚠️ 敏感:能操作整个 Vercel 账号。仅环境读取,绝不 log/打印。面试后轮换/删除。
VERCEL_TOKEN=你的vercel_token

#Supabase(生成应用的后端:Auth + Postgres;Project Settings → API)
# 公开 anon key(前端可见,RLS 兜底安全)
SUPABASE_URL=https://你的项目.supabase.co
SUPABASE_ANON_KEY=你的anon_key

#Supabase 动态建表(可选但推荐,否则需手抄 SQL 进 Dashboard)
# service_role key:⚠️ 极敏感,绕 RLS。目前 Supabase HTTP API 不支持用它执行 DDL,本仓库
#   仅读入预留(见 config.py 注释)。绝不 log/打印/注入生成应用。面试后轮换。
SUPABASE_SERVICE_ROLE_KEY=你的service_role_key
# Personal Access Token(★ 动态建表实际用):https://supabase.com/dashboard/account/tokens 生成,
# 格式 sbp_...。⚠️ 极敏感,能管理整个 Supabase 账号。deploy_app 用它调 Management API
#   /v1/projects/{ref}/database/query 建 design.supabase_tables 的表。不配 → deploy_app 跳过建表(非阻塞)。
SUPABASE_ACCESS_TOKEN=你的supabase_pat

#会话持久化(刷新工作台 / 容器重启后恢复对话 + 代码 + 预览)
#Supabase Postgres 连接串。dashboard → Project Settings → Database → Connect → URI(Session mode,端口 5432)。
#⚠️ 必须用 Session 模式(5432),不要用 Transaction 模式(6543)——后者与 prepared statements 冲突。
#⚠️ 含数据库密码,敏感。空着不填 → 后端回落内存存储(进程重启即丢),仅适合本地快速调试。
#本地开发可不填;生产部署(Railway)务必填上。
DATABASE_URL=postgresql://postgres.你的ref:你的密码@aws-0-区域.pooler.supabase.com:5432/postgres

# 服务端口(可选,默认 8000)
# PORT=8000

# 前端 CORS 源(可选,默认 http://localhost:3000)
# FRONTEND_ORIGIN=http://localhost:3000
